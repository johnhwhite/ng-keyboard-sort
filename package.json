{
  "name": "ng-keyboard-sort",
  "description": "Angular keyboard sort directive",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhwhite/ng-keyboard-sort.git",
    "directory": "libs/ng-keyboard-sort"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng s e2e",
    "build": "ng b ng-keyboard-sort && ng b e2e",
    "build:package": "ng b ng-keyboard-sort -c production",
    "watch": "ng b ng-keyboard-sort --watch -c development",
    "test": "ng test ng-keyboard-sort --configuration=ci",
    "test:e2e": "ng test e2e --configuration=ci",
    "test:all": "ng test --configuration=ci --no-watch",
    "e2e": "playwright test --config apps/e2e/playwright.config.ts --workers 1",
    "lint": "ng lint ng-keyboard-sort",
    "lint:e2e": "ng lint e2e",
    "lint:all": "ng lint",
    "commitlint": "commitlint --edit",
    "validate-commit-msg": "commitlint --strict"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.2",
    "semver": "^7.8.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2202.1",
    "@angular-devkit/core": "22.2.1",
    "@angular-devkit/schematics": "22.2.1",
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@angular/localize": "22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-angular": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/types": "^8.71.0",
    "@typescript-eslint/typescript-estree": "^8.71.0",
    "@typescript-eslint/utils": "^8.71.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "30.1.2",
    "ng-packagr": "22.2.4",
    "playwright-ng-schematics": "^22.1.2",
    "playwright-webkit": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-import": "~17.0.0",
    "postcss-preset-env": "~11.6.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
